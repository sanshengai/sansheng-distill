# sansheng-distill -- environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Where your book / distill data lives (input book.txt, JSON, output HTML).
# If unset, defaults to ./distill-data
DISTILL_DATA_DIR=

# --- video-series path only (optional) ---
# Gemini API key -- used to analyze video frames/audio when subtitles are missing.
GOOGLE_API_KEY=
# API key for a third-party Douyin/Bilibili transcription tool, if you use one.
AI_DOUYIN_API_KEY=

# --- Step 3 (web enrichment) ---
# Web search runs through Claude Code's MCP search tools (AnySearch / Tavily /
# WebSearch) -- configure those in Claude Code itself, not here.
