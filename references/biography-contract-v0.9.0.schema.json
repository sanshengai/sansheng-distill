{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sanshengai/sansheng-distill/v0.8.0/references/biography-contract-v0.9.0.schema.json",
  "title": "Biography contract v0.9.0 candidate registry",
  "description": "Manifest、来源、治理账本与六类 Canonical 的结构单一真源；跨文件闭包由 biography_contract.py 消费本注册表后统一验证。",
  "$ref": "#/$defs/ManifestV2",
  "$defs": {
    "Slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "LocalRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\\\x00-\\x1F])[^/]+(?:/[^/]+)*$"},
    "PersonId": {"type": "string", "pattern": "^per-[a-z0-9-]+$"},
    "ObservationId": {"type": "string", "pattern": "^obs-[a-z0-9-]+$"},
    "CanonicalStatus": {"enum": ["active", "hold", "merged_redirect"]},
    "StringIdArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "EvidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ObservationId"}, "uniqueItems": true},
    "InterpretationRefs": {"type": "array", "items": {"$ref": "#/$defs/ObservationId"}, "uniqueItems": true},
    "VerificationRefs": {"type": "array", "items": {"type": "string", "pattern": "^ver-[a-z0-9-]+$"}, "uniqueItems": true},

    "Certainty": {"enum": ["confirmed", "probable", "disputed", "unknown"]},
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "SourceLocator": {
      "type": "object",
      "required": ["locator_type", "value"],
      "properties": {
        "locator_type": {"enum": ["page", "leaf", "juan", "line", "entry", "accession", "chapter_position", "web_fragment"]},
        "value": {"type": "string", "minLength": 1},
        "edition_id": {"type": "string", "minLength": 1},
        "witness_id": {"type": "string", "minLength": 1},
        "juan": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "page": {"type": ["string", "integer"], "minLength": 1},
        "leaf": {"type": "string", "minLength": 1},
        "line": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1},
        "accession": {"type": "string", "minLength": 1},
        "url_fragment": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"locator_type": {"const": "page"}}, "required": ["locator_type"]}, "then": {"required": ["page"], "not": {"required": ["leaf"]}}},
        {"if": {"properties": {"locator_type": {"const": "leaf"}}, "required": ["locator_type"]}, "then": {"required": ["leaf"], "not": {"required": ["page"]}}},
        {"if": {"properties": {"locator_type": {"const": "accession"}}, "required": ["locator_type"]}, "then": {"required": ["accession"]}}
      ],
      "additionalProperties": false
    },
    "TemporalConversion": {
      "type": "object",
      "required": ["method", "normalized_calendar_system", "basis_evidence_refs", "certainty"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "normalized_calendar_system": {"enum": ["gregorian", "proleptic_gregorian"]},
        "basis_evidence_refs": {"$ref": "#/$defs/EvidenceRefs"},
        "certainty": {"$ref": "#/$defs/Certainty"}
      },
      "additionalProperties": false
    },
    "TemporalSpan": {
      "type": "object",
      "required": ["calendar_system", "original_text", "display_label", "precision"],
      "properties": {
        "calendar_system": {"enum": ["gregorian", "julian", "proleptic_gregorian", "chinese_lunisolar", "regnal", "unknown"]},
        "original_text": {"type": "string", "minLength": 1},
        "display_label": {"type": "string", "minLength": 1},
        "start": {"type": ["string", "null"], "format": "date"},
        "end": {"type": ["string", "null"], "format": "date"},
        "precision": {"enum": ["exact_day", "day", "month", "season", "year", "range", "approximate", "unknown"]},
        "conversion": {"$ref": "#/$defs/TemporalConversion"}
      },
      "allOf": [
        {"if": {"properties": {"calendar_system": {"enum": ["julian", "chinese_lunisolar", "regnal"]}}, "required": ["calendar_system"], "anyOf": [{"required": ["start"]}, {"required": ["end"]}]}, "then": {"required": ["conversion"]}},
        {"if": {"properties": {"precision": {"enum": ["exact_day", "day"]}}, "required": ["precision"]}, "then": {"required": ["start"]}},
        {"if": {"properties": {"precision": {"enum": ["month", "season", "year"]}}, "required": ["precision"]}, "then": {"dependentRequired": {"start": ["end"], "end": ["start"]}}},
        {"if": {"properties": {"precision": {"const": "range"}}, "required": ["precision"]}, "then": {"required": ["start", "end"]}}
      ],
      "additionalProperties": false
    },

    "NameForm": {
      "type": "object",
      "required": ["name_form_id", "text", "kind", "language", "script", "evidence_refs", "certainty"],
      "properties": {
        "name_form_id": {"type": "string", "pattern": "^name-[a-z0-9-]+$"},
        "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["primary", "native", "romanized", "alias", "birth_name", "courtesy_name", "art_name", "posthumous_name", "pseudonym"]},
        "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
        "script": {"type": "string", "pattern": "^[A-Z][a-z]{3}$"},
        "display_role": {"const": "secondary"},
        "evidence_refs": {"$ref": "#/$defs/EvidenceRefs"},
        "valid_during": {"$ref": "#/$defs/TemporalSpan"},
        "certainty": {"$ref": "#/$defs/Certainty"},
        "derivation": {"type": "object", "required": ["method", "basis_evidence_refs"], "properties": {"method": {"type": "string", "minLength": 1}, "basis_evidence_refs": {"$ref": "#/$defs/EvidenceRefs"}}, "additionalProperties": false},
        "note": {"type": ["string", "null"]}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "romanized"}}, "required": ["kind"]}, "then": {"required": ["derivation"]}}],
      "additionalProperties": false
    },
    "NameForms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/NameForm"},
      "contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "primary"}}},
      "minContains": 1,
      "maxContains": 1
    },
    "LegacyObjectId": {
      "type": "object",
      "required": ["id", "kind", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["people", "events", "works", "relations", "controversies", "quotes"]},
        "reason": {"type": "string", "minLength": 1},
        "introduced_before": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "IdAlias": {
      "type": "object",
      "required": ["alias_id", "target_id", "kind", "public", "reason"],
      "properties": {
        "alias_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["people", "events", "works", "relations", "controversies", "quotes"]},
        "public": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "SubjectV2": {
      "type": "object",
      "required": ["slug", "subject_id", "id_namespace", "language"],
      "properties": {
        "slug": {"$ref": "#/$defs/Slug"},
        "subject_id": {"$ref": "#/$defs/PersonId"},
        "id_namespace": {"$ref": "#/$defs/Slug"},
        "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
        "legacy_object_ids": {"type": "array", "items": {"$ref": "#/$defs/LegacyObjectId"}, "uniqueItems": true},
        "id_aliases": {"type": "array", "items": {"$ref": "#/$defs/IdAlias"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "CanonicalFiles": {
      "type": "object",
      "required": ["people", "events", "works", "relations", "controversies", "quotes"],
      "properties": {
        "people": {"$ref": "#/$defs/LocalRef"}, "events": {"$ref": "#/$defs/LocalRef"},
        "works": {"$ref": "#/$defs/LocalRef"}, "relations": {"$ref": "#/$defs/LocalRef"},
        "controversies": {"$ref": "#/$defs/LocalRef"}, "quotes": {"$ref": "#/$defs/LocalRef"}
      },
      "additionalProperties": false
    },
    "EditorialFiles": {
      "type": "object",
      "required": ["chapter_order", "chapters", "overview", "layout", "dossier", "media"],
      "properties": {
        "chapter_order": {"$ref": "#/$defs/LocalRef"}, "chapters": {"$ref": "#/$defs/LocalRef"},
        "overview": {"$ref": "#/$defs/LocalRef"}, "layout": {"$ref": "#/$defs/LocalRef"},
        "dossier": {"$ref": "#/$defs/LocalRef"}, "media": {"$ref": "#/$defs/LocalRef"}
      },
      "additionalProperties": false
    },
    "SourceRegistryDescriptor": {
      "type": "object", "required": ["ref", "schema_version"],
      "properties": {"ref": {"$ref": "#/$defs/LocalRef"}, "schema_version": {"const": "biography-source-audit-v1"}},
      "additionalProperties": false
    },
    "LedgerDescriptor": {
      "type": "object", "required": ["kind", "ref", "schema_version", "required_for_publication"],
      "properties": {
        "kind": {"enum": ["observations", "merge_decisions", "external_verifications", "source_coverage_decisions", "work_classifications", "work_duplicate_decisions", "work_identity_decisions", "quote_attribution_audits", "prose_risk_reviews", "changesets", "model_recommendations", "media_assets"]},
        "ref": {"$ref": "#/$defs/LocalRef"}, "schema_version": {"type": "string", "minLength": 1},
        "required_for_publication": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "FormalReviewerRegistration": {
      "type": "object", "required": ["reviewer_id", "authority"],
      "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "authority": {"enum": ["human", "main_agent"]}},
      "additionalProperties": false
    },
    "GovernanceV2": {
      "type": "object", "required": ["formal_reviewers", "source_registry", "ledgers"],
      "properties": {
        "formal_reviewers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/FormalReviewerRegistration"}},
        "source_registry": {"$ref": "#/$defs/SourceRegistryDescriptor"},
        "ledgers": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/LedgerDescriptor"}}
      },
      "additionalProperties": false
    },
    "SharedResource": {
      "type": "object", "required": ["resource_id", "kind", "ref", "owner", "read_only", "sha256"],
      "properties": {
        "resource_id": {"type": "string", "pattern": "^series-[a-z0-9-]+$"}, "kind": {"enum": ["asset", "css", "component", "tokens"]},
        "ref": {"type": "string", "pattern": "^@series/[A-Za-z0-9._/-]+$"}, "owner": {"const": "biography-series"},
        "read_only": {"const": true}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "ProjectionV2": {
      "type": "object", "required": ["projection_id", "canonical_library_id", "route_base", "asset_base", "asset_target", "css_scope", "shared_resources"],
      "properties": {
        "projection_id": {"type": "string", "pattern": "^projection-[a-z0-9-]+-store$"},
        "canonical_library_id": {"type": "string", "pattern": "^canonical-[a-z0-9-]+-store$"},
        "route_base": {"type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/)+$"},
        "asset_base": {"type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/)+$"},
        "asset_target": {"$ref": "#/$defs/LocalRef"},
        "css_scope": {"type": "string", "minLength": 1},
        "asset_source_ref": {"$ref": "#/$defs/LocalRef"},
        "media_ledger_ref": {"$ref": "#/$defs/LocalRef"},
        "css_source_ref": {"$ref": "#/$defs/LocalRef"},
        "css_target": {"$ref": "#/$defs/LocalRef"},
        "dossier_config_ref": {"$ref": "#/$defs/LocalRef"},
        "retired_public_files": {"type": "array", "items": {"$ref": "#/$defs/LocalRef"}, "uniqueItems": true},
        "shared_resource_root": {"$ref": "#/$defs/LocalRef"},
        "shared_resources": {"type": "array", "items": {"$ref": "#/$defs/SharedResource"}}
      },
      "allOf": [{"if": {"properties": {"shared_resources": {"minItems": 1}}, "required": ["shared_resources"]}, "then": {"required": ["shared_resource_root"]}}],
      "additionalProperties": false
    },
    "PublicationV2": {
      "type": "object", "required": ["status", "href", "catalog_summary"],
      "properties": {
        "status": {"enum": ["draft", "review", "published"]},
        "href": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/)+$"}]},
        "catalog_name": {"type": "string", "minLength": 1}, "catalog_summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ManifestV2": {
      "type": "object",
      "required": ["schema_version", "biography_contract_version", "subject", "content_version", "canonical", "editorial", "governance", "projection", "publication", "required_files"],
      "properties": {
        "schema_version": {"const": "biography-store-manifest-v2"}, "biography_contract_version": {"const": "0.9.0-candidate"},
        "subject": {"$ref": "#/$defs/SubjectV2"}, "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
        "canonical": {"$ref": "#/$defs/CanonicalFiles"}, "editorial": {"$ref": "#/$defs/EditorialFiles"},
        "governance": {"$ref": "#/$defs/GovernanceV2"}, "projection": {"$ref": "#/$defs/ProjectionV2"},
        "publication": {"$ref": "#/$defs/PublicationV2"},
        "required_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/LocalRef"}, "uniqueItems": true}
      },
      "not": {"required": ["latin_name"]}, "additionalProperties": false
    },

    "CorpusSubjectV1": {
      "type": "object",
      "required": ["slug", "store_ref", "subject_id", "id_namespace", "route_base"],
      "properties": {
        "slug": {"$ref": "#/$defs/Slug"}, "store_ref": {"$ref": "#/$defs/LocalRef"},
        "subject_id": {"$ref": "#/$defs/PersonId"}, "id_namespace": {"$ref": "#/$defs/Slug"},
        "route_base": {"type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/)+$"}
      },
      "additionalProperties": false
    },
    "BiographyCorpusV1": {
      "type": "object",
      "required": ["schema_version", "subjects"],
      "properties": {
        "schema_version": {"const": "biography-corpus-v1"},
        "subjects": {"type": "array", "items": {"$ref": "#/$defs/CorpusSubjectV1"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },

    "SourceUnitV1": {
      "type": "object", "required": ["source_id", "source_type", "observation_refs", "verification_refs"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["book", "article", "archive", "manuscript", "museum_object", "database", "website", "oral_history", "other"]},
        "title": {"type": "string", "minLength": 1},
        "editions": {"type": "array", "items": {"$ref": "#/$defs/SourceEdition"}, "uniqueItems": true},
        "witnesses": {"type": "array", "items": {"$ref": "#/$defs/SourceWitness"}, "uniqueItems": true},
        "observation_refs": {"type": "array", "items": {"$ref": "#/$defs/ObservationId"}, "uniqueItems": true},
        "verification_refs": {"type": "array", "items": {"type": "string", "pattern": "^ver-[a-z0-9-]+$"}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"source_type": {"enum": ["book", "archive", "manuscript", "museum_object"]}}, "required": ["source_type"]}, "then": {"required": ["witnesses"], "properties": {"witnesses": {"minItems": 1}}}}
      ],
      "additionalProperties": true
    },
    "SourceEdition": {
      "type": "object", "required": ["edition_id", "label"],
      "properties": {"edition_id": {"type": "string", "pattern": "^ed-[a-z0-9-]+$"}, "label": {"type": "string", "minLength": 1}, "publication": {"type": "string"}, "evidence_refs": {"$ref": "#/$defs/EvidenceRefs"}},
      "additionalProperties": false
    },
    "SourceWitness": {
      "type": "object", "required": ["witness_id", "label", "witness_type"],
      "properties": {"witness_id": {"type": "string", "pattern": "^wit-[a-z0-9-]+$"}, "label": {"type": "string", "minLength": 1}, "witness_type": {"enum": ["manuscript", "print", "inscription", "facsimile", "digital_surrogate", "translation"]}, "edition_id": {"type": "string", "pattern": "^ed-[a-z0-9-]+$"}, "holding": {"type": "string"}, "accession_id": {"type": "string"}},
      "additionalProperties": false
    },
    "SourceRegistryV1": {
      "type": "object", "required": ["schema_version", "registry_id", "subject_id", "id_namespace", "source_units"],
      "properties": {
        "schema_version": {"const": "biography-source-audit-v1"}, "registry_id": {"type": "string", "minLength": 1},
        "subject_id": {"$ref": "#/$defs/PersonId"}, "id_namespace": {"$ref": "#/$defs/Slug"},
        "source_units": {"type": "array", "items": {"$ref": "#/$defs/SourceUnitV1"}}
      },
      "additionalProperties": true
    },
    "ObservationV2": {
      "type": "object",
      "required": ["schema_version", "observation_id", "subject_id", "id_namespace", "source_id", "anchor", "observation_type", "statement_kind", "statement", "verification_status"],
      "properties": {
        "schema_version": {"const": "biography-observation-v2"}, "observation_id": {"$ref": "#/$defs/ObservationId"},
        "subject_id": {"$ref": "#/$defs/PersonId"}, "id_namespace": {"$ref": "#/$defs/Slug"},
        "source_id": {"type": "string", "minLength": 1}, "anchor": {"$ref": "#/$defs/SourceLocator"},
        "observation_type": {"type": "string", "minLength": 1}, "statement_kind": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}, "verification_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "FormalReview": {
      "type": "object", "required": ["authority", "reviewer_id", "reviewed_at", "recommendation_refs"],
      "properties": {
        "authority": {"enum": ["human", "main_agent"]}, "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "recommendation_refs": {"type": "array", "items": {"type": "string", "pattern": "^rec-[a-z0-9-]+$"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "MigrationBasis": {
      "type": "object", "required": ["source_schema_version", "legacy_decision_id", "original_reviewed_at", "migrated_at", "note"],
      "properties": {
        "source_schema_version": {"type": "string", "minLength": 1}, "legacy_decision_id": {"type": "string", "minLength": 1},
        "original_reviewed_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "migrated_at": {"type": "string", "format": "date-time"}, "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "MergeDecisionV2": {
      "type": "object",
      "required": ["schema_version", "decision_id", "subject_id", "id_namespace", "scope", "observation_ids", "target_ids", "superseded_ids", "verdict", "reason", "conflicts", "review", "changeset_id", "migration_basis", "status"],
      "properties": {
        "schema_version": {"const": "biography-merge-decision-v2"}, "decision_id": {"type": "string", "pattern": "^md-[a-z0-9-]+$"},
        "subject_id": {"$ref": "#/$defs/PersonId"}, "id_namespace": {"$ref": "#/$defs/Slug"},
        "scope": {"enum": ["observation_admission", "canonical_resolution"]},
        "observation_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ObservationId"}, "uniqueItems": true},
        "target_ids": {"$ref": "#/$defs/StringIdArray"}, "superseded_ids": {"$ref": "#/$defs/StringIdArray"},
        "verdict": {"enum": ["accept", "hold", "reject", "adopt", "create", "enrich", "correct", "merge"]},
        "reason": {"type": "string", "minLength": 1}, "conflicts": {"type": "array", "items": {"type": "string"}},
        "review": {"$ref": "#/$defs/FormalReview"}, "changeset_id": {"type": "string", "pattern": "^cs-[a-z0-9-]+$"},
        "migration_basis": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/MigrationBasis"}]},
        "status": {"enum": ["signed", "superseded"]}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "observation_admission"}}, "required": ["scope"]}, "then": {"properties": {"verdict": {"enum": ["accept", "hold", "reject"]}, "target_ids": {"maxItems": 0}, "superseded_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"scope": {"const": "canonical_resolution"}}, "required": ["scope"]}, "then": {"properties": {"verdict": {"enum": ["adopt", "create", "enrich", "correct", "merge"]}, "target_ids": {"minItems": 1}}}},
        {"if": {"properties": {"scope": {"const": "canonical_resolution"}, "verdict": {"const": "merge"}}, "required": ["scope", "verdict"]}, "then": {"properties": {"superseded_ids": {"minItems": 1}}}},
        {"if": {"properties": {"scope": {"const": "canonical_resolution"}, "verdict": {"enum": ["adopt", "create", "enrich", "correct"]}}, "required": ["scope", "verdict"]}, "then": {"properties": {"superseded_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"verdict": {"const": "adopt"}}, "required": ["verdict"]}, "then": {"properties": {"migration_basis": {"$ref": "#/$defs/MigrationBasis"}}}, "else": {"properties": {"migration_basis": {"type": "null"}}}}
      ],
      "additionalProperties": false
    },
    "ExternalVerificationV1": {
      "type": "object", "required": ["schema_version", "verification_id", "subject_id", "id_namespace", "target_ids", "source_ids", "verdict", "review", "changeset_id", "status"],
      "properties": {
        "schema_version": {"const": "biography-external-verification-v1"}, "verification_id": {"type": "string", "pattern": "^ver-[a-z0-9-]+$"},
        "subject_id": {"$ref": "#/$defs/PersonId"}, "id_namespace": {"$ref": "#/$defs/Slug"},
        "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "verdict": {"enum": ["confirmed", "probable", "disputed", "unresolved"]}, "review": {"$ref": "#/$defs/FormalReview"}, "changeset_id": {"type": "string", "pattern": "^cs-[a-z0-9-]+$"},
        "status": {"enum": ["signed", "superseded"]}
      },
      "additionalProperties": true
    },
    "SourceCoverageDecisionV1": {
      "type": "object", "required": ["schema_version", "decision_id", "subject_id", "id_namespace", "source_id", "disposition", "review", "changeset_id", "status"],
      "properties": {"schema_version": {"const": "biography-source-coverage-decision-v1"}, "decision_id": {"type": "string", "pattern": "^srcdec-[a-z0-9-]+$"}, "subject_id": {"$ref": "#/$defs/PersonId"}, "id_namespace": {"$ref": "#/$defs/Slug"}, "source_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["covered", "partially_covered", "hold", "excluded"]}, "review": {"$ref": "#/$defs/FormalReview"}, "changeset_id": {"type": "string", "pattern": "^cs-[a-z0-9-]+$"}, "status": {"enum": ["signed", "superseded"]}},
      "additionalProperties": true
    },
    "WorkClassificationV1": {
